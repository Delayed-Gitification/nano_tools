    "def validate_split(data, linkage_matrix, threshold_ratio=3.0):\n",
    "    \"\"\"\n",
    "    Checks if the final split into 2 clusters is valid based on the ratio\n",
    "    of Inter-Cluster Distance to Intra-Cluster Distance.\n",
    "    \"\"\"\n",
    "    # 1. Get the Inter-Cluster Distance\n",
    "    # The last row of linkage_matrix is the merge of the final 2 clusters.\n",
    "    # Format: [idx1, idx2, distance, sample_count]\n",
    "    last_merge = linkage_matrix[-1]\n",
    "    inter_cluster_distance = last_merge[2] \n",
    "    \n",
    "    print(f\"--- Analysis ---\")\n",
    "    print(f\"Inter-Cluster Distance (Separation): {inter_cluster_distance:.4f}\")\n",
    "\n",
    "    # 2. Identify the labels for the 2 clusters\n",
    "    # fcluster extracts labels based on a requested number of clusters (k=2)\n",
    "    labels = fcluster(linkage_matrix, t=2, criterion='maxclust')\n",
    "    \n",
    "    unique_labels = np.unique(labels)\n",
    "    intra_distances = []\n",
    "\n",
    "    # 3. Calculate Mean Intra-Cluster Distance for each cluster\n",
    "    for label in unique_labels:\n",
    "        # Get data points belonging to this cluster\n",
    "        cluster_points = data[labels == label]\n",
    "        \n",
    "        # Calculate pairwise distances inside this cluster\n",
    "        if len(cluster_points) > 1:\n",
    "            # pdist computes distances between all pairs\n",
    "            distances = pdist(cluster_points, metric='euclidean')\n",
    "            mean_dist = np.mean(distances)\n",
    "        else:\n",
    "            mean_dist = 0.0 # Single point has 0 internal distance\n",
    "            \n",
    "        intra_distances.append(mean_dist)\n",
    "        print(f\"Cluster {label} Mean Internal Distance: {mean_dist:.4f}\")\n",
    "\n",
    "    # Average the internal tightness of the two clusters\n",
    "    avg_intra_distance = np.mean(intra_distances)\n",
    "    \n",
    "    # 4. The Validation Check\n",
    "    # \"3 times more similar\" implies the separation (inter) is 3x the spread (intra)\n",
    "    ratio = inter_cluster_distance / avg_intra_distance if avg_intra_distance > 0 else np.inf\n",
    "    \n",
    "    is_valid = ratio >= threshold_ratio\n",
    "    \n",
    "    print(f\"--- Result ---\")\n",
    "    print(f\"Ratio (Inter / Intra): {ratio:.2f}\")\n",
    "    print(f\"Is valid split? (Ratio >= {threshold_ratio}): {is_valid}\")\n",
    "    \n",
    "    return is_valid\n",
