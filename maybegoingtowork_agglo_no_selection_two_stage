    "def recursive_close_analysis_of_cluster(cluster_df, expected_error_rate, mi_exclusion_distance, verbose):\n",
    "\n",
    "    barcodes = cluster_df['Barcode'].tolist()\n",
    "    inserts = cluster_df['Insert'].tolist()\n",
    "\n",
    "    msa_int, mi_matrix, msa_subset, dist_matrix_subset, labels, len_msa_inserts = cluster_barcode_insert_pairs(barcodes, \n",
    "                                                                                   inserts, \n",
    "                                                                                   mi_exclusion_distance,\n",
    "                                                                                   expected_error_rate,\n",
    "                                                                                   verbose=0,\n",
    "                                                                                    jump_thresh = 3,\n",
    "                                                                                    subset_msa=False)\n",
    "\n",
    "    if len(set(labels)) <= 1:\n",
    "        if verbose >= 3:\n",
    "            print(\"Only 1 label, clustering is finished\")\n",
    "        return cluster_df\n",
    "\n",
    "    # --- 3. RECURSIVE STEP: Process the splits ---\n",
    "    # Create unique IDs for these new sub-clusters\n",
    "    # (Using hash ensures they don't clash with previous layers)\n",
    "    unique_labels = [l + hash(frozenset(cluster_df.index)) % 10_000_000 for l in labels]\n",
    "    \n",
    "    cluster_df = cluster_df.copy()\n",
    "    cluster_df['cluster'] = unique_labels\n",
    "    \n",
    "    sub_results = []\n",
    "    \n",
    "    for label in set(unique_labels):\n",
    "        sub_group = cluster_df[cluster_df['cluster'] == label]\n",
    "\n",
    "        print(sub_group)\n",
    "        \n",
    "        # RECURSE: Call this same function on the new sub-group\n",
    "        # It will try to split it again.\n",
    "        processed_sub_group = recursive_close_analysis_of_cluster(\n",
    "            sub_group, expected_error_rate, mi_exclusion_distance, verbose\n",
    "        )\n",
    "        sub_results.append(processed_sub_group)\n",
    "        \n",
    "    return pd.concat(sub_results)\n",
    "\n",
